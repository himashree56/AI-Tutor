# .env template for AI Tutor Backend
# Copy this file to .env and customize as needed

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-tutor

# Embedding Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Reranker Model Configuration
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=10

# Retrieval Configuration
RETRIEVAL_TOP_K=20
RETRIEVAL_SCORE_THRESHOLD=0.3

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_MAX_TOKENS=2048
OLLAMA_NUM_CTX=4096

# LLM Provider selection: ollama, huggingface, openrouter
LLM_PROVIDER=ollama

# OpenRouter Configuration
# Get your API key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Alternative: HuggingFace Local Model
USE_OLLAMA=true
HF_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2
HF_DEVICE_MAP=auto

# Quiz Generation
QUIZ_NUM_QUESTIONS=5
QUIZ_TEMPERATURE=0.8

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Memory Configuration
MAX_MEMORY_TURNS=10
MEMORY_SESSION_TTL=3600
